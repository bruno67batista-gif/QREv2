# Para desenvolvimento local, deixe DATABASE_URL vazio (usa SQLite local).
# Para publicação multiusuário, configure um PostgreSQL persistente no provedor e coloque a URL aqui como variável secreta:
DATABASE_URL=
# Ative se o site estiver atrás de HTTPS e o proxy não informar X-Forwarded-Proto:
COOKIE_SECURE=true
# Para depuração local, opcional:
DEBUG=false
